@model AppTask.Models.Departamento

@{
    ViewData["Title"] = "Detalhes - Departamento";
}

<h1>Detalhes</h1>

<dl class="row">
        <dt class="col-sm-3">Descrição</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Descricao)</dd>
        <dt class="col-sm-3">Ativo</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Ativo)</dd>
</dl>
<div>
    <a asp-action="Edit" asp-route-id="@Model!.Codigo" class="btn btn-outline-secondary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
</div>
