@model AppTask.Models.Incidente

@{
    ViewData["Title"] = "Excluir - Incidente";
}

<h1>Excluir</h1>

<h3>Tem certeza que deseja excluir este registro?</h3>
<dl class="row">
        <dt class="col-sm-3">Descrição do Problema</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.DescricaoProblema)</dd>
        <dt class="col-sm-3">Data do Incidente</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.DataIncidente)</dd>
        <dt class="col-sm-3">Solução</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Solucao)</dd>
        <dt class="col-sm-3">Resolvido (sim/nao)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Resolvido)</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Codigo" />
    <button type="submit" class="btn btn-danger">Excluir</button>
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
</form>
