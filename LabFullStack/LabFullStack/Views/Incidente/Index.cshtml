@model IEnumerable<AppTask.Models.Incidente>

@{
    ViewData["Title"] = "Incidente - Lista";
}

<h1>Incidente</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Novo</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Problema</th>
            <th>Data</th>
            <th>Resolvido</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.DescricaoProblema)</td>
            <td>@Html.DisplayFor(modelItem => item.DataIncidente)</td>
            <td>@Html.DisplayFor(modelItem => item.Resolvido)</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Codigo" class="btn btn-sm btn-outline-secondary">Editar</a>
                <a asp-action="Details" asp-route-id="@item.Codigo" class="btn btn-sm btn-outline-info">Detalhes</a>
                <a asp-action="Delete" asp-route-id="@item.Codigo" class="btn btn-sm btn-outline-danger">Excluir</a>
            </td>
        </tr>
}
    </tbody>
</table>
