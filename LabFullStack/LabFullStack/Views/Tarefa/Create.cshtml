@model AppTask.Models.Tarefa

@{
    ViewData["Title"] = "Novo Tarefa";
}

<h1>Novo Tarefa</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="Descricao" class="control-label">Descrição</label>
                <input asp-for="Descricao" class="form-control" />
                <span asp-validation-for="Descricao" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="DataPlanejada" class="control-label">Data Planejada</label>
                <input asp-for="DataPlanejada" class="form-control" type="date" />
                <span asp-validation-for="DataPlanejada" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="DataIniciada" class="control-label">Data Iniciada</label>
                <input asp-for="DataIniciada" class="form-control" type="date" />
                <span asp-validation-for="DataIniciada" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="DataFinalizada" class="control-label">Data Finalizada</label>
                <input asp-for="DataFinalizada" class="form-control" type="date" />
                <span asp-validation-for="DataFinalizada" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="DataCancelada" class="control-label">Data Cancelada</label>
                <input asp-for="DataCancelada" class="form-control" type="date" />
                <span asp-validation-for="DataCancelada" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="StatusTarefa" class="control-label">Status</label>
                <input asp-for="StatusTarefa" class="form-control" />
                <span asp-validation-for="StatusTarefa" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Prazo" class="control-label">Prazo</label>
                <input asp-for="Prazo" class="form-control" />
                <span asp-validation-for="Prazo" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="FuncionarioId" class="control-label">Funcionário</label>
                <select asp-for="FuncionarioId" class ="form-control" asp-items="ViewBag.FuncionarioId"></select>
                <span asp-validation-for="FuncionarioId" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Salvar</button>
            <a asp-action="Index" class="btn btn-secondary">Voltar</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
