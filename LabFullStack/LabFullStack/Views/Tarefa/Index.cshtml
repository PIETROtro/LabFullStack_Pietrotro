@model IEnumerable<AppTask.Models.Tarefa>

@{
    ViewData["Title"] = "Tarefa - Lista";
}

<h1>Tarefa</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Novo</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Descrição</th>
            <th>Data Planejada</th>
            <th>Status</th>
            <th>Prazo</th>
            <th>Funcionário</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Descricao)</td>
            <td>@Html.DisplayFor(modelItem => item.DataPlanejada)</td>
            <td>@Html.DisplayFor(modelItem => item.StatusTarefa)</td>
            <td>@Html.DisplayFor(modelItem => item.Prazo)</td>
            <td>@Html.DisplayFor(modelItem => item.Funcionario.Nome)</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Codigo" class="btn btn-sm btn-outline-secondary">Editar</a>
                <a asp-action="Details" asp-route-id="@item.Codigo" class="btn btn-sm btn-outline-info">Detalhes</a>
                <a asp-action="Delete" asp-route-id="@item.Codigo" class="btn btn-sm btn-outline-danger">Excluir</a>
            </td>
        </tr>
}
    </tbody>
</table>
