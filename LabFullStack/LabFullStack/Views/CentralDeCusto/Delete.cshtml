@model AppTask.Models.CentralDeCusto

@{
    ViewData["Title"] = "Excluir - CentralDeCusto";
}

<h1>Excluir</h1>

<h3>Tem certeza que deseja excluir este registro?</h3>
<dl class="row">
        <dt class="col-sm-3">Nome da Central</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.NomeCentral)</dd>
        <dt class="col-sm-3">Valor Meta Anual</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.ValorMetaAnual)</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Codigo" />
    <button type="submit" class="btn btn-danger">Excluir</button>
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
</form>
