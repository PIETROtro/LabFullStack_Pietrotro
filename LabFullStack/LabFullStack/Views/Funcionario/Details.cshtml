@model AppTask.Models.Funcionario

@{
    ViewData["Title"] = "Detalhes - Funcionario";
}

<h1>Detalhes</h1>

<dl class="row">
        <dt class="col-sm-3">Nome</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Nome)</dd>
        <dt class="col-sm-3">Cargo</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Cargo)</dd>
</dl>
<div>
    <a asp-action="Edit" asp-route-id="@Model!.Codigo" class="btn btn-outline-secondary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
</div>
