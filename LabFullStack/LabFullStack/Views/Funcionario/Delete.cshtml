@model AppTask.Models.Funcionario

@{
    ViewData["Title"] = "Excluir - Funcionario";
}

<h1>Excluir</h1>

<h3>Tem certeza que deseja excluir este registro?</h3>
<dl class="row">
        <dt class="col-sm-3">Nome</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Nome)</dd>
        <dt class="col-sm-3">Cargo</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Cargo)</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Codigo" />
    <button type="submit" class="btn btn-danger">Excluir</button>
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
</form>
